# If you have a D-ID API key for server-side fetching, set it here
# D_ID_API_KEY=your_did_api_key_here

# Server-only AI configuration. Store these in Replit Secrets, not in Vite/client env.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Server-only administrator credentials. Store these in Replit Secrets.
# ADMIN_USERNAME=your_admin_username
# ADMIN_PASSWORD=use_a_long_random_password

# Optional: change proxy listen port
# PROXY_PORT=4000
