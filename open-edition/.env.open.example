# قالبُ إعدادات النسخة المفتوحة. انسخه إلى جذر المستودع باسم `.env.open`
# (مستثنى من git) واملأه. لا تضع القيم الحقيقية في هذا الملف.

# --- القاعدة الجديدة manara-open-app ---
MANARA_EDITION=open
SUPABASE_URL=https://yvvgvbwokclinsiabmzx.supabase.co
# المفتاح العام (publishable / anon): للتطبيق وللتحقّق.
SUPABASE_ANON_KEY=sb_publishable_...
# مفتاح الخدمة (secret / service_role): للخادم ولسكربت الاستنساخ وحدهما — لا يوضع في أيّ واجهة.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- القاعدة القديمة (قراءةٌ وحدها، لسكربت الاستنساخ) ---
OLD_SUPABASE_URL=https://<المشروع-القديم>.supabase.co
OLD_SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
