modules = ["python-base-3.13", "nodejs-20"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
DID_AGENT_ID = "v2_agt_xjzPw33U"

[nix]
channel = "stable-25_05"

# ── لا فلاتر ولا JDK في طبقة nix ──
#
# كانت `packages = ["flutter", "jdk17"]`، وهي سببُ تعليق النشر عند
# `Pushing nix-0 layer...`. فحزمةُ nix تُبنى للمساحة وللنشر معاً، ومغلقُ
# flutter في nixpkgs يجرّ معه Dart SDK وأدواتِ البناء — قريباً من
# غيغابايتين — و jdk17 نحو ثلث غيغابايت. فكان النشرُ يرفع ما يقارب
# غيغابايتين ونصفاً من طبقةِ بيئةٍ قبل أن يرفع خادماً حجمُه سبعةُ
# ميغابايتات.
#
# والمنشورُ خادمُ Node في `artifacts/api-server`: لا يشغّل Dart ولا
# يجمّع APK ولا يحتاج Java. وبناءُ الـAPK يقع في GitHub Actions — انظر
# `.github/workflows/build-student-apk.yml` — وهي تُنصّب flutter و jdk
# لنفسها في كل تشغيل.
#
# وثمنُ هذا مقولٌ صراحةً: لا يعمل أمرُ `flutter` في صَدَفة Replit بعد
# اليوم. وهو ثمنٌ لم يكن يُدفع مقابل شيء — الـAPK لم يُبنَ من المساحة
# أصلاً — وردُّه سطرٌ واحد لمن احتاجه يوماً.
packages = []

